{
  "schema_version": 3,
  "name": "claude-code",
  "description": "Registers Mnemon generic lifecycle hooks in Claude Code.",
  "surfaces": {
    "projection": [
      ".claude/hooks/mnemon-r1",
      ".claude/settings.json"
    ],
    "observation": [
      ".mnemon/hosts/claude-code/manifest.json",
      ".mnemon/harness/local/render-audit.jsonl"
    ]
  },
  "lifecycle_mapping": {
    "enter": [
      "SessionStart"
    ],
    "mid": [
      "UserPromptSubmit"
    ],
    "exit": [
      "Stop",
      "PreCompact"
    ]
  },
  "mechanics": {
    "stdin_read": {
      "default": "strict"
    },
    "dialect": {
      "default": "plain"
    },
    "json_escape": true
  },
  "turn_io": {
    "turn-in": "[mnemon:wake] sentinel query",
    "turn-out": "turn output (report anchor)"
  },
  "maintenance": "subagent-or-manual"
}
