{
  "schema_version": 3,
  "name": "codex",
  "display_name": "Codex",
  "description": "Registers Mnemon generic lifecycle hooks in Codex.",
  "surfaces": {
    "projection": [
      ".codex/hooks/mnemon-r1",
      ".codex/hooks.json"
    ],
    "observation": [
      ".mnemon/hosts/codex/manifest.json",
      ".mnemon/harness/local/render-audit.jsonl"
    ]
  },
  "lifecycle_mapping": {
    "enter": [
      "SessionStart"
    ],
    "mid": [
      "UserPromptSubmit"
    ],
    "exit": [
      "Stop",
      "PreCompact"
    ]
  },
  "supports": {
    "skills": true,
    "hooks": true,
    "subagents": false
  },
  "mechanics": {
    "stdin_read": {
      "default": "tolerant"
    },
    "dialect": {
      "default": "system-message-only"
    },
    "json_escape": true
  },
  "turn_io": {
    "turn-in": "[mnemon:wake] sentinel query",
    "turn-out": "turn output (report anchor)"
  },
  "maintenance": "manual skill invocation"
}
